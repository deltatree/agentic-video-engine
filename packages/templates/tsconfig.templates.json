{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@agentic-video/sdk",
    "paths": {
      "@agentic-video/*": ["../*/src/index.ts"],
      "@agentic-video/sdk/jsx-runtime": ["../sdk/src/jsx-runtime.ts"],
      "@agentic-video/sdk/jsx-dev-runtime": ["../sdk/src/jsx-dev-runtime.ts"]
    }
  },
  "include": ["templates/*/src/**/*.tsx", "templates/*/src/**/*.ts"]
}
