                },
              },
              "required": [
                "type",
              ],
              "type": "object",
            },
          ],
        },
        "height": {
          "minimum": 1,
          "type": "number",
        },
        "markup": {
          "description": "Inline SVG markup.",
          "type": "string",
        },
        "path": {
          "description": "SVG path data in viewBox coordinates.",
          "type": "string",
        },
        "reveal": {
          "enum": [
            "scale",
            "mask",
            "trim",
            "none",
          ],
        },
        "svgAsset": {
          "description": "SVG asset id.",
          "type": "string",
        },
        "viewBox": {
          "description": "Coordinate size of \`path\`. Default: width × height.",
          "properties": {
