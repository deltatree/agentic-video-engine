  {
    "description": "Logo from an image asset (\`asset\`), an SVG asset (\`svgAsset\`), inline SVG (\`markup\`) or SVG path data (\`path\`, drawn in \`color\`). Reveal: \`scale\` (pop in), \`mask\` (wipe from left), \`trim\` (outline draws, then fill fades in; needs \`path\`, otherwise falls back to \`mask\`).",
    "example": {
      "height": 200,
      "path": "M 20 100 L 100 20 L 180 100 L 100 180 Z M 70 100 L 100 70 L 130 100 L 100 130 Z",
      "reveal": "trim",
      "viewBox": {
        "height": 200,
        "width": 200,
      },
      "width": 200,
    },
    "name": "Logo",
    "propsSchema": {
      "additionalProperties": false,
      "properties": {
        "asset": {
          "description": "Image asset id.",
          "type": "string",
        },
        "color": {
          "description": "Color for \`path\`. Default: theme.colors.primary.",
          "pattern": "^(#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|transparent)$",
          "type": "string",
        },
        "duration": {
          "anyOf": [
            {
              "type": "number",
            },
            {
              "type": "string",
            },
          ],
        },
        "enter": {
          "anyOf": [
            {
              "enum": [
                "none",
                "fade",
                "slide-up",
                "slide-down",
                "slide-left",
                "slide-right",
                "scale",
              ],
            },
            {
              "additionalProperties": false,
              "properties": {
                "distance": {
                  "description": "Slide distance in pixels. Default: theme.spacing.xl.",
                  "minimum": 0,
                  "type": "number",
                },
                "duration": {
                  "anyOf": [
                    {
                      "description": "Time in frames.",
                      "type": "number",
                    },
                    {
                      "description": "Time with unit: "2s", "500ms", "48f", "00:00:02:00", "marker:intro+10f".",
                      "pattern": "^(-?[0-9]+(\\.[0-9]+)?(s|ms|f)|[0-9]{2}:[0-9]{2}:[0-9]{2}[:;][0-9]{2}|marker:[A-Za-z][A-Za-z0-9_.-]*([+-][0-9]+(\\.[0-9]+)?(s|ms|f))?)$",
                      "type": "string",
                    },
                  ],
                  "description": "Frames as number or a string with unit.",
                  "examples": [
                    "2s",
                  ],
                },
                "ease": {
                  "description": "Easing name. Default: theme.easing.enter / theme.easing.exit.",
                  "type": "string",
                },
                "type": {
                  "enum": [
                    "none",
                    "fade",
                    "slide-up",
                    "slide-down",
                    "slide-left",
                    "slide-right",
                    "scale",
                  ],
                },
              },
              "required": [
                "type",
              ],
              "type": "object",
            },
          ],
        },
        "exit": {
          "anyOf": [
            {
              "enum": [
                "none",
                "fade",
                "slide-up",
                "slide-down",
                "slide-left",
                "slide-right",
                "scale",
              ],
            },
            {
              "additionalProperties": false,
              "properties": {
                "distance": {
                  "description": "Slide distance in pixels. Default: theme.spacing.xl.",
                  "minimum": 0,
