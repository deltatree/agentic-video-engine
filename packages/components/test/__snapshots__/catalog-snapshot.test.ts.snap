                  "anyOf": [
                    {
                      "description": "Time in frames.",
                      "type": "number",
                    },
                    {
                      "description": "Time with unit: "2s", "500ms", "48f", "00:00:02:00", "marker:intro+10f".",
                      "pattern": "^(-?[0-9]+(\\.[0-9]+)?(s|ms|f)|[0-9]{2}:[0-9]{2}:[0-9]{2}[:;][0-9]{2}|marker:[A-Za-z][A-Za-z0-9_.-]*([+-][0-9]+(\\.[0-9]+)?(s|ms|f))?)$",
                      "type": "string",
                    },
                  ],
                  "description": "Frames as number or a string with unit.",
                  "examples": [
                    "2s",
                  ],
                },
                "ease": {
                  "description": "Easing name. Default: theme.easing.enter / theme.easing.exit.",
                  "type": "string",
                },
                "type": {
                  "enum": [
                    "none",
                    "fade",
                    "slide-up",
                    "slide-down",
                    "slide-left",
                    "slide-right",
                    "scale",
