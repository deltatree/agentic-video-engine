{
  "$schema": "../../packages/schema/openvideo.schema.json",
  "schemaVersion": "1.0.0",
  "metadata": {
    "title": "Social vertical",
    "description": "9:16 short with three tip cards in a sequence and karaoke captions.",
    "tags": ["example", "social", "vertical", "captions"],
    "createdWith": "examples/social-vertical"
  },
  "settings": {
    "theme": { "colors": { "primary": "#14B8A6", "secondary": "#8B5CF6", "accent": "#FACC15", "background": "#0B0D12", "surface": "#151A24", "text": "#FFFFFF", "muted": "#A3ADC2" } }
  },
  "assets": [
    { "id": "avatar", "type": "image", "src": "assets/avatar.png", "license": { "name": "CC0-1.0", "attribution": "Generated by examples/social-vertical/generate-assets.mjs" } }
  ],
  "compositions": [
    {
      "id": "main",
      "width": 1080,
      "height": 1920,
      "fps": 30,
      "duration": "8s",
      "background": "#0B0D12",
      "tracks": [
        {
          "id": "captions",
          "kind": "subtitle",
          "language": "en",
          "cues": [
            { "start": "0.2s", "end": "2.6s", "text": "Three tips for faster renders", "words": [{ "text": "Three", "start": "0.2s", "end": "0.6s" }, { "text": "tips", "start": "0.6s", "end": "1s" }, { "text": "for", "start": "1s", "end": "1.3s" }, { "text": "faster", "start": "1.3s", "end": "1.9s" }, { "text": "renders", "start": "1.9s", "end": "2.6s" }] },
            { "start": "2.8s", "end": "5.2s", "text": "Cache every single frame", "words": [{ "text": "Cache", "start": "2.8s", "end": "3.4s" }, { "text": "every", "start": "3.4s", "end": "3.9s" }, { "text": "single", "start": "3.9s", "end": "4.5s" }, { "text": "frame", "start": "4.5s", "end": "5.2s" }] },
            { "start": "5.4s", "end": "7.8s", "text": "Split the work across workers", "words": [{ "text": "Split", "start": "5.4s", "end": "5.9s" }, { "text": "the", "start": "5.9s", "end": "6.1s" }, { "text": "work", "start": "6.1s", "end": "6.6s" }, { "text": "across", "start": "6.6s", "end": "7.1s" }, { "text": "workers", "start": "7.1s", "end": "7.8s" }] }
          ]
        }
      ],
      "nodes": [
        { "id": "backdrop", "type": "component", "component": "GradientBackground", "props": { "width": 1080, "height": 1920, "colors": ["#0B0D12", "#1E1B4B", "#0F766E"], "angle": 160, "speed": 5 } },
        { "id": "story-progress", "type": "component", "component": "ProgressBar", "props": { "width": 936, "height": 8, "duration": "8s", "label": false }, "x": 72, "y": 96 },
        {
          "id": "creator",
          "type": "group",
          "x": 72,
          "y": 150,
          "children": [
            { "id": "creator-avatar", "type": "image", "asset": "avatar", "width": 96, "height": 96, "mask": { "node": { "id": "creator-avatar-mask", "type": "ellipse", "width": 96, "height": 96, "fill": "#FFFFFF" } } },
            { "id": "creator-name", "type": "text", "text": "@tidewise", "x": 120, "y": 18, "fontSize": 40, "fontWeight": 700, "fill": { "$ref": "theme.colors.text" } },
            { "id": "creator-badge", "type": "component", "component": "Badge", "props": { "label": "TIPS", "variant": "accent" }, "x": 120, "y": 66 }
          ]
        },
        {
          "id": "cards",
          "type": "sequence",
          "x": 72,
          "y": 560,
          "transitions": [{ "type": "slide-up", "duration": "0.5s", "ease": "easeOutCubic" }, { "type": "zoom-in", "duration": "0.5s", "ease": "easeOutBack" }],
          "children": [
            {
              "id": "card-intro",
              "type": "group",
              "timing": { "duration": "3s" },
              "children": [
                { "id": "card-intro-bg", "type": "rect", "width": 936, "height": 620, "cornerRadius": 48, "fill": { "$ref": "theme.colors.surface" } },
                { "id": "card-intro-kicker", "type": "text", "text": "RENDER FASTER", "x": 64, "y": 80, "fontSize": 36, "fontWeight": 700, "letterSpacing": 4, "fill": { "$ref": "theme.colors.primary" } },
                { "id": "card-intro-title", "type": "text", "text": "3 tips in 8 seconds", "x": 64, "y": 160, "width": 808, "fontSize": 104, "fontWeight": 800, "lineHeight": 1.05, "fill": { "$ref": "theme.colors.text" }, "textAnimation": { "unit": "word", "stagger": 5, "duration": 14, "from": { "opacity": 0, "y": 50 } } }
              ]
            },
            {
              "id": "card-cache",
              "type": "group",
              "timing": { "duration": "3s" },
              "children": [
                { "id": "card-cache-bg", "type": "rect", "width": 936, "height": 620, "cornerRadius": 48, "fill": { "$ref": "theme.colors.surface" } },
                { "id": "card-cache-number", "type": "text", "text": "1", "x": 64, "y": 40, "fontSize": 200, "fontWeight": 800, "fill": { "$ref": "theme.colors.accent" } },
                { "id": "card-cache-title", "type": "text", "text": "Cache every frame", "x": 64, "y": 300, "width": 808, "fontSize": 88, "fontWeight": 800, "lineHeight": 1.05, "fill": { "$ref": "theme.colors.text" } }
              ]
            },
            {
              "id": "card-workers",
              "type": "group",
              "timing": { "duration": "3s" },
              "children": [
                { "id": "card-workers-bg", "type": "rect", "width": 936, "height": 620, "cornerRadius": 48, "fill": { "$ref": "theme.colors.surface" } },
                { "id": "card-workers-number", "type": "text", "text": "2", "x": 64, "y": 40, "fontSize": 200, "fontWeight": 800, "fill": { "$ref": "theme.colors.accent" } },
                { "id": "card-workers-title", "type": "text", "text": "Split across workers", "x": 64, "y": 300, "width": 808, "fontSize": 88, "fontWeight": 800, "lineHeight": 1.05, "fill": { "$ref": "theme.colors.text" } }
              ]
            }
          ]
        },
        { "id": "captions-view", "type": "subtitles", "track": "captions", "fontSize": 64, "fontWeight": 800, "style": "karaoke", "color": "#FFFFFF", "highlightColor": "#FACC15", "stroke": "#000000", "strokeWidth": 6, "position": "bottom", "safeArea": 0.14, "maxWidth": 900 }
      ]
    }
  ],
  "renderProfiles": [{ "id": "vertical", "format": "mp4", "codec": "h264", "quality": 80 }]
}
