{
  "$schema": "../../packages/schema/openvideo.schema.json",
  "schemaVersion": "1.0.0",
  "metadata": {
    "title": "Product launch",
    "description": "Three-scene launch video: logo reveal, numbers chart, call to action, with music.",
    "tags": ["example", "launch"],
    "createdWith": "examples/product-launch"
  },
  "settings": {
    "theme": { "colors": { "primary": "#FF5A1F", "secondary": "#8A2BE2", "accent": "#FFC857", "background": "#0B0D12", "surface": "#161B26", "text": "#F5F7FF", "muted": "#9AA3B8" } }
  },
  "assets": [
    { "id": "logo", "type": "image", "src": "assets/logo.png", "license": { "name": "CC0-1.0", "attribution": "Generated by examples/product-launch/generate-assets.mjs" } },
    { "id": "music-file", "type": "audio", "src": "assets/music.wav", "license": { "name": "CC0-1.0", "attribution": "Generated by examples/product-launch/generate-assets.mjs" } }
  ],
  "audio": [{ "id": "music", "asset": "music-file" }],
  "compositions": [
    {
      "id": "main",
      "width": 1920,
      "height": 1080,
      "fps": 30,
      "duration": "8s",
      "background": "#0B0D12",
      "audio": { "loudness": -16 },
      "tracks": [
        { "id": "soundtrack", "kind": "audio", "role": "music", "clips": [{ "id": "music-clip", "source": "music", "start": 0, "volume": 0.7, "fadeIn": "0.5s", "fadeOut": "1s" }] }
      ],
      "nodes": [
        { "id": "backdrop", "type": "component", "component": "GradientBackground", "props": { "width": 1920, "height": 1080, "angle": 135, "speed": 6 } },
        {
          "id": "scenes",
          "type": "sequence",
          "between": { "type": "slide-left", "duration": "0.5s", "ease": "easeInOutCubic" },
          "transitions": [{ "type": "slide-left", "duration": "0.5s", "ease": "easeInOutCubic" }, { "type": "fade", "duration": "0.6s" }],
          "children": [
            {
              "id": "intro",
              "type": "group",
              "timing": { "duration": "3s" },
              "children": [
                {
                  "id": "logo-image",
                  "type": "image",
                  "asset": "logo",
                  "x": 832,
                  "y": 220,
                  "width": 256,
                  "height": 256,
                  "scale": { "$spring": { "from": { "x": 0.4, "y": 0.4 }, "to": { "x": 1, "y": 1 }, "at": 0, "stiffness": 140, "damping": 14 } },
                  "opacity": { "$keyframes": [{ "t": 0, "v": 0 }, { "t": "0.4s", "v": 1 }] }
                },
                { "id": "product-name", "type": "component", "component": "Title", "props": { "text": "Meet Flowcast", "width": 1600, "align": "center", "fontSize": 120 }, "x": 160, "y": 540 },
                { "id": "new-badge", "type": "component", "component": "Badge", "props": { "label": "NEW", "variant": "accent" }, "x": 900, "y": 720, "timing": { "from": "0.8s" } }
              ]
            },
            {
              "id": "numbers",
              "type": "group",
              "timing": { "duration": "3s" },
              "children": [
                { "id": "numbers-heading", "type": "text", "text": "Renders per day, in thousands", "x": 160, "y": 120, "width": 1600, "textAlign": "center", "fontSize": 64, "fontWeight": 700, "fill": { "$ref": "theme.colors.text" } },
                {
                  "id": "numbers-chart",
                  "type": "component",
                  "component": "BarChart",
                  "props": { "data": [{ "label": "Mon", "value": 18 }, { "label": "Tue", "value": 26 }, { "label": "Wed", "value": 31 }, { "label": "Thu", "value": 44 }, { "label": "Fri", "value": 57 }], "width": 1400, "height": 640, "showValues": true, "duration": "1.2s", "delay": "0.3s" },
                  "x": 260,
                  "y": 280
                }
              ]
            },
            {
              "id": "cta",
              "type": "group",
              "timing": { "duration": "3.1s" },
              "children": [
                { "id": "cta-title", "type": "text", "text": "Available today", "x": 160, "y": 380, "width": 1600, "textAlign": "center", "fontSize": 110, "fontWeight": 800, "fill": { "$ref": "theme.colors.text" }, "textAnimation": { "unit": "word", "stagger": 6, "duration": 14, "from": { "opacity": 0, "y": 40 } } },
                { "id": "cta-url", "type": "text", "text": "flowcast.example", "x": 160, "y": 560, "width": 1600, "textAlign": "center", "fontSize": 52, "fill": { "$ref": "theme.colors.accent" }, "opacity": { "$keyframes": [{ "t": "0.6s", "v": 0 }, { "t": "1.1s", "v": 1, "ease": "easeOutCubic" }] } },
                { "id": "cta-underline", "type": "line", "from": { "x": 760, "y": 650 }, "to": { "x": 1160, "y": 650 }, "stroke": { "$ref": "theme.colors.primary" }, "strokeWidth": 6, "strokeCap": "round", "trimEnd": { "$keyframes": [{ "t": "0.9s", "v": 0 }, { "t": "1.6s", "v": 1, "ease": "easeOutCubic" }] } }
              ]
            }
          ]
        }
      ]
    }
  ],
  "renderProfiles": [{ "id": "web", "format": "mp4", "codec": "h264", "quality": 80 }]
}
