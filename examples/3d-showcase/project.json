{
  "$schema": "../../packages/schema/openvideo.schema.json",
  "schemaVersion": "1.0.0",
  "metadata": {
    "title": "3D showcase",
    "description": "A glTF gem on a turntable: orbiting camera, three lights, shadows, particles and bloom, with a 2D title on top.",
    "tags": ["example", "3d"],
    "createdWith": "examples/3d-showcase"
  },
  "assets": [
    { "id": "gem", "type": "model", "src": "assets/gem.glb", "license": { "name": "CC0-1.0", "attribution": "Generated by examples/3d-showcase/generate-assets.mjs" } }
  ],
  "compositions": [
    {
      "id": "main",
      "width": 1280,
      "height": 720,
      "fps": 30,
      "duration": "6s",
      "background": "#05060A",
      "nodes": [
        {
          "id": "stage",
          "type": "scene3d",
          "width": 1280,
          "height": 720,
          "camera": "cam",
          "background": "#05060A",
          "environment": { "preset": "studio", "intensity": 0.35 },
          "shadows": true,
          "toneMapping": "aces",
          "backend": "auto",
          "postprocessing": { "bloom": { "strength": 0.5, "radius": 0.4, "threshold": 0.8 } },
          "children": [
            {
              "id": "cam",
              "type": "camera3d",
              "fov": 38,
              "target": [0, 0.5, 0],
              "position": { "$keyframes": [{ "t": 0, "v": [0, 1.4, 5.2] }, { "t": "6s", "v": [3.2, 1.8, 3.6], "ease": "easeInOutSine" }] }
            },
            { "id": "fill", "type": "light3d", "kind": "ambient", "intensity": 0.35 },
            { "id": "key", "type": "light3d", "kind": "directional", "position": [3, 6, 3], "target": [0, 0, 0], "intensity": 2.6, "castShadow": true },
            { "id": "rim", "type": "light3d", "kind": "point", "position": [-2.5, 2, -2], "color": "#4F8CFF", "intensity": 12, "distance": 10 },
            {
              "id": "gem-model",
              "type": "model3d",
              "asset": "gem",
              "position": [0, 0.9, 0],
              "scale": [0.8, 0.8, 0.8],
              "rotation": { "$keyframes": [{ "t": 0, "v": [0, 0, 0] }, { "t": "6s", "v": [0, 240, 0] }] },
              "animation": { "clip": "bob", "loop": true },
              "castShadow": true
            },
            { "id": "pedestal", "type": "mesh3d", "geometry": { "type": "cylinder", "radiusTop": 0.9, "radiusBottom": 1, "height": 0.3, "segments": 48 }, "position": [0, -0.25, 0], "material": { "color": "#1B2030", "roughness": 0.35, "metalness": 0.6 }, "castShadow": true, "receiveShadow": true },
            { "id": "floor", "type": "mesh3d", "geometry": { "type": "plane", "width": 20, "height": 20 }, "rotation": [-90, 0, 0], "position": [0, -0.4, 0], "material": { "color": "#05070C", "roughness": 0.9 }, "receiveShadow": true },
            {
              "id": "sparkles",
              "type": "particles3d",
              "count": 400,
              "seed": 11,
              "position": [0, 1, 0],
              "emitter": { "shape": "sphere", "size": 2.5 },
              "lifetime": { "min": 1.5, "max": 3 },
              "speed": { "min": 0.05, "max": 0.25 },
              "gravity": [0, 0.05, 0],
              "size": { "start": 0.04, "end": 0 },
              "color": { "start": "#FFFFFF", "end": "#4F8CFF" },
              "additive": true
            }
          ]
        },
        { "id": "title", "type": "text", "text": "Gem One", "x": 80, "y": 560, "fontSize": 72, "fontWeight": 800, "fill": "#F5F7FF", "textAnimation": { "unit": "char", "stagger": 2, "duration": 16, "from": { "opacity": 0, "y": 30 } } },
        { "id": "tagline", "type": "text", "text": "Rendered in real time with Three.js", "x": 80, "y": 648, "fontSize": 28, "fill": "#9AA3B8", "opacity": { "$keyframes": [{ "t": "0.8s", "v": 0 }, { "t": "1.4s", "v": 1 }] } }
      ]
    }
  ],
  "renderProfiles": [{ "id": "web", "format": "mp4", "codec": "h264", "quality": 80 }]
}
