{
  "name": "agentic-video-engine",
  "private": true,
  "version": "0.1.0",
  "description": "OpenVideo – open-source platform for video as code, built for coding agents.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -b tsconfig.json",
    "lint": "tsc -p tsconfig.eslint.json && tsc -p apps/studio/tsconfig.json && tsc -p examples/tsconfig.json && eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:deps": "node scripts/check-deps.mjs",
    "check:docs": "node scripts/generate-docs.mjs --check && node scripts/check-doc-numbers.mjs",
    "check": "npm run check:deps && npm run build && npm run lint && npm run check:docs && node scripts/licenses.mjs --check && npm test",
    "licenses": "node scripts/licenses.mjs",
    "docs": "node scripts/generate-docs.mjs && typedoc",
    "smoke:npx": "node scripts/smoke-npx.mjs",
    "setup": "node scripts/setup.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.13.0",
    "@vitest/coverage-v8": "5.0.2",
    "eslint": "^10.11.0",
    "fast-check": "^4.10.2",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.13.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
