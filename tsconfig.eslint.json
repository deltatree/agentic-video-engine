{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "paths": {
      "@agentic-video/*": [
        "./packages/*/src/index.ts"
      ]
    }
  },
  "include": [
    "packages/schema/src/**/*.ts",
    "packages/timeline/src/**/*.ts",
    "packages/core/src/**/*.ts",
    "packages/png/src/**/*.ts",
    "packages/testing/src/**/*.ts",
    "packages/fonts/src/**/*.ts",
    "packages/renderer-skia/src/**/*.ts",
    "packages/compositor/src/**/*.ts",
    "packages/ffmpeg/src/**/*.ts",
    "packages/audio/src/**/*.ts",
    "packages/cache/src/**/*.ts",
    "packages/assets/src/**/*.ts",
    "packages/telemetry/src/**/*.ts",
    "packages/render/src/**/*.ts",
    "packages/agent/src/**/*.ts",
    "packages/mcp/src/**/*.ts",
    "packages/components/src/**/*.ts",
    "packages/subtitles/src/**/*.ts",
    "packages/speech/src/**/*.ts",
    "packages/renderer-blender/src/**/*.ts",
    "packages/schema/test/**/*.ts",
    "packages/timeline/test/**/*.ts",
    "packages/core/test/**/*.ts",
    "packages/png/test/**/*.ts",
    "packages/testing/test/**/*.ts",
    "packages/fonts/test/**/*.ts",
    "packages/renderer-skia/test/**/*.ts",
    "packages/compositor/test/**/*.ts",
    "packages/ffmpeg/test/**/*.ts",
    "packages/audio/test/**/*.ts",
    "packages/cache/test/**/*.ts",
    "packages/assets/test/**/*.ts",
    "packages/telemetry/test/**/*.ts",
    "packages/render/test/**/*.ts",
    "packages/agent/test/**/*.ts",
    "packages/mcp/test/**/*.ts",
    "packages/components/test/**/*.ts",
    "packages/subtitles/test/**/*.ts",
    "packages/speech/test/**/*.ts",
    "packages/renderer-blender/test/**/*.ts",
    "vitest.config.ts"
  ]
}