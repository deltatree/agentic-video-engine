# Vorlage: nach secrets.env kopieren und jeden Wert ersetzen (nur Buchstaben und Ziffern).
# Erzeugen: openssl rand -hex 32   (jeder Wert ein eigener; Tokens mindestens 24 Zeichen)
# Der Koordinator startet nicht mit "REPLACE…", zu kurzen oder gleichen Rollen-Tokens.
api-token=REPLACE
submit-token=REPLACE
worker-token=REPLACE
metrics-token=REPLACE
s3-admin-access-key-id=REPLACE
s3-admin-secret-access-key=REPLACE
s3-api-access-key-id=REPLACE
s3-api-secret-access-key=REPLACE
s3-worker-access-key-id=REPLACE
s3-worker-secret-access-key=REPLACE
